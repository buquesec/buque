# Copy to .env (do not commit .env). Values below are local-dev placeholders.

# PostgreSQL
VULN_PG_HOST=127.0.0.1
VULN_PG_PORT=5432
VULN_PG_DB=vuln_mgmt
VULN_PG_USER=vuln
VULN_PG_PASSWORD=change-me

# Optional local paths
# VULN_STORAGE_DIR=./data/uploads
# VULN_SONAR_SCANNER_HOME=
# VULN_DATA_ROOT=./data
# Release zip only: VULN_UI_STATIC_DIR=./frontend
# VULN_UI_URL=http://127.0.0.1:8080

# Production secrets — never commit real values
# VULN_LICENSE_AES_KEY=
# VULN_UPDATE_HMAC_KEY=

# AI (OpenAI-compatible). Leave empty to hide AI解读 / 通报提取.
# VULN_AI_ENABLED=true
# VULN_AI_BASE_URL=
# VULN_AI_API_KEY=
# VULN_AI_MODEL=
# VULN_AI_AUTH_TYPE=BEARER
